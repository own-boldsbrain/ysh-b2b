{
  "name": "yello-solar-hub-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start -H 0.0.0.0 -p ${PORT:-9000}",
    "start:migrate": "npm run migrate && npm start",
    "migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "db:setup": "medusa db:create && medusa db:migrate",
    "catalog:import": "medusa exec ./src/scripts/import-catalog.ts",
    "normalize:ids": "tsx scripts/normalize-product-ids.ts",
    "enrich:images": "medusa exec ./scripts/enrich-product-images.ts",
    "promote:official-images": "tsx scripts/promote-official-images.ts",
    "aws:check-cert": "node scripts/check-certificate-status.js",
    "aws:monitor-cert": "node scripts/monitor-certificate-validation.js",
    "aws:create-cloudfront": "node scripts/create-cloudfront-distribution.js",
    "aws:check-cloudfront": "node scripts/check-cloudfront-status.js",
    "aws:monitor-cloudfront": "node scripts/monitor-cloudfront-deployment.js",
    "aws:setup-all": "node scripts/setup-complete-infrastructure.js",
    "aws:auto-deploy": "node scripts/auto-deploy-cdn.js",
    "aws:invalidate-cache": "node scripts/invalidate-cloudfront-cache.js",
    "aws:update-urls": "node scripts/update-image-urls-to-cloudfront.js",
    "aws:sync-images": "node scripts/sync-manufacturer-images-to-cdn.js",
    "aws:generate-index": "node scripts/generate-images-index.js",
    "aws:generate-sku-sync": "node scripts/generate-sku-sync-report.js",
    "aws:generate-catalog": "node scripts/generate-detailed-catalog.js",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "worker:start": "node dist/workers/index.js",
    "workflow:extract": "node dist/cli/extract-catalog.js",
    "workflow:status": "node dist/cli/workflow-status.js",
    "health-check": "node dist/cli/health-check.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.920.0",
    "@aws-sdk/client-s3": "^3.913.0",
    "@aws-sdk/lib-dynamodb": "^3.920.0",
    "@langchain/community": "^0.3.57",
    "@langchain/ollama": "^0.2.4",
    "@mastra/core": "^0.21.1",
    "@mastra/engine": "^0.1.0-alpha.84",
    "@medusajs/admin-sdk": "^2.10.3",
    "@medusajs/framework": "^2.10.3",
    "@medusajs/js-sdk": "^2.10.3",
    "@medusajs/medusa": "^2.10.3",
    "@medusajs/types": "^2.10.3",
    "@medusajs/workflows-sdk": "^2.10.3",
    "@mikro-orm/core": "^6.4.3",
    "@mikro-orm/migrations": "^6.4.3",
    "@mikro-orm/postgresql": "^6.4.3",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.5.13",
    "awilix": "^8.0.1",
    "aws-sdk": "^2.1692.0",
    "chromadb": "^3.0.17",
    "chromadb-default-embed": "^2.14.0",
    "cohere-ai": "^7.19.0",
    "facebook-sdk": "^0.3.3",
    "framer-motion": "^12.23.24",
    "langchain": "^0.3.36",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "playwright": "^1.56.1",
    "ts-node": "^10.9.2",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@medusajs/test-utils": "^2.10.3",
    "@mikro-orm/cli": "^6.4.3",
    "@swc/core": "^1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "zod": "^3.23.8"
  }
}
