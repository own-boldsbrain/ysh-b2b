# ==========================================
# .dockerignore - YSH B2B Backend
# Otimizado para reduzir tamanho da imagem
# ==========================================

# ====================
# 1. CONTROLE DE VERSÃO
# ====================
.git
.gitignore
.gitattributes
.github/

# ====================
# 2. DEPENDÊNCIAS (npm/yarn)
# ====================
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn-integrity
.npm
.eslintcache

# ====================
# 3. AMBIENTE E CONFIGURAÇÃO
# ====================
# Arquivos de ambiente (exceto template)
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test
!.env.template
!.env.example

# Configuração de build
.npmrc
.yarnrc.yml

# ====================
# 4. BUILD E CACHE
# ====================
dist/
.next/
out/
.nuxt/
.cache/
.medusa/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
*.tgz

# ====================
# 5. TESTES
# ====================
# Diretórios de teste
__tests__/
integration-tests/
pact/
coverage/
.nyc_output/

# Arquivos de teste
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
**/*.e2e.spec.ts
jest.config.js
jest.setup.js

# ====================
# 6. DOCUMENTAÇÃO
# ====================
docs/
*.md
!README.md

# Manter apenas README principal
INDEX.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE.md

# ====================
# 7. DOCKER E DEPLOY
# ====================
Dockerfile*
docker-compose*.yml
.dockerignore
*.log

# Task definitions AWS
*-task-def-*.json
*-task-new.json

# Scripts de deploy (manter apenas necessários)
deploy-*.ps1
deploy-*.sh
!entrypoint.sh
!start-prod.sh

# ====================
# 8. SCRIPTS E FERRAMENTAS
# ====================
scripts/
*.ps1
*.sh
!entrypoint.sh
!start-prod.sh
!start-dev.sh

# Análise e otimização
analyze-*.ps1
test-*.ps1
fix-*.js
migrate-*.js
run-*.js

# ====================
# 9. DADOS E UPLOADS
# ====================
# Grandes volumes de dados
data/catalog/
data/products-inventory/
data/products-inventory-backup*/
data/project-helios/

# Uploads e arquivos estáticos
uploads/
static/images*/
static/products/
output/

# Arquivos JSON grandes
products-*.json
unified_products.json
*.backup

# ====================
# 10. DATABASE
# ====================
database/
init-scripts/
*.sql
*.sqlite
*.db

# ====================
# 11. LOGS E TEMPORÁRIOS
# ====================
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock
tmp/
temp/
.node_repl_history

# ====================
# 12. IDE E EDITOR
# ====================
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/

# ====================
# 13. SISTEMA OPERACIONAL
# ====================
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ====================
# 14. PERFORMANCE E MONITORING
# ====================
# Arquivos de configuração local
config/local/
secrets/
*.pem
*.key
*.cert

# ====================
# 15. OUTROS ARQUIVOS
# ====================
# Patches e análises
*.patch
analyze-*.ps1
check-*.js

# Arquivos de metadados
.medusa
tsconfig.build.json
tailwind.config.js
eslint.config.js
.prettierrc.js
.eslintrc.js

# Arquivos HTTP de teste
*.http

# ====================
# EXCEÇÕES (Arquivos a INCLUIR)
# ====================
# Adicione aqui arquivos que devem ser incluídos
# mesmo que correspondam a padrões acima
!entrypoint.sh
!start-prod.sh
!medusa-config.js
!package.json
!package-lock.json