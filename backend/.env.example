AWS_CLOUDWATCH_LOG_STREAM=monitoring-service
AWS_CLOUDWATCH_NAMESPACE=YSH-B2B/DistributorMonitoring

# ====================
# DISTRIBUTOR MONITORING
# ====================
# Health check configuration
MONITORING_CHECK_INTERVAL_MS=60000
MONITORING_TIMEOUT_MS=5000
MONITORING_CONSECUTIVE_FAILURES_THRESHOLD=3
MONITORING_DEGRADED_PERFORMANCE_THRESHOLD=80
MONITORING_CACHE_TTL_SECONDS=300

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Kafka/Redpanda
KAFKA_BROKERS=localhost:19092

# Browser Automation
CHROME_WS_ENDPOINT=ws://localhost:3333
CHROME_TOKEN=ysh-chrome-token-2025

# ====================
# MONITORING
# ====================
