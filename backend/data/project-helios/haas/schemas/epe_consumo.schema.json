{
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "EPE Consumo de Energia Elétrica",
      "description": "Schema para dados de consumo mensal de energia elétrica por classe da EPE (Empresa de Pesquisa Energética). Série histórica de 2004 em diante, atualizado mensalmente via SAM e COPAM.",
      "type": "object",
      "version": "1.0.0",
      "metadata": {
            "data_source": "EPE - Empresa de Pesquisa Energética",
            "source_url": "https://www.epe.gov.br/pt/publicacoes-dados-abertos/publicacoes/consumo-de-energia-eletrica",
            "file_format": "XLSX",
            "file_url": "https://www.epe.gov.br/_layouts/download.aspx?sourceURL=%2Fsites-pt%2Fpublicacoes-dados-abertos%2Fpublicacoes%2FDocuments%2FCONSUMO%2520MENSAL%2520DE%2520ENERGIA%2520EL%25c3%2589TRICA%2520POR%2520CLASSE.xlsx",
            "update_frequency": "Mensal",
            "responsible_team": "Superintendência de Estudos Econômicos e Energéticos / Estatísticas Energéticas",
            "data_origin": "SAM - Sistema de Acompanhamento do Mercado / COPAM - Comissão Permanente de Análise e Acompanhamento do Mercado",
            "historical_range": "2004-01-01 até presente",
            "geographic_coverage": [
                  "Nacional",
                  "Regiões (Norte, Nordeste, Sudeste, Sul, Centro-Oeste)",
                  "Subsistemas (SIN, Sistemas Isolados)",
                  "Unidades Federativas (27 estados)"
            ],
            "energy_classes": [
                  "Residencial",
                  "Industrial",
                  "Comercial",
                  "Rural",
                  "Serviço Público",
                  "Iluminação Pública",
                  "Outros"
            ],
            "consumption_environments": [
                  "Cativo",
                  "Livre",
                  "Total"
            ],
            "key_metrics": [
                  "Consumo Mensal (GWh)",
                  "Consumo Anual (GWh)",
                  "Taxa de Variação Interanual (%)",
                  "Número de Consumidores",
                  "Consumo Médio por Consumidor (kWh/consumidor)",
                  "Consumo per Capita (kWh/habitante)"
            ],
            "industrial_sectors": [
                  "Metalurgia",
                  "Química",
                  "Alimentos e Bebidas",
                  "Papel e Celulose",
                  "Mineração",
                  "Cimento",
                  "Ferro-Ligas",
                  "Soda-Cloro",
                  "Outros Eletrointensivos"
            ],
            "related_publications": [
                  "Resenha do Mercado de Energia Elétrica",
                  "Boletim Trimestral de Consumo de Eletricidade",
                  "Anuário Estatístico de Energia Elétrica"
            ],
            "priority": "Core Infrastructure",
            "use_cases": [
                  "Análise de mercado regional e nacional",
                  "Projeções de demanda energética",
                  "Estudos de tarifa e tarifação",
                  "Benchmark de consumo por classe",
                  "Análise de migração ACL (Ambiente de Contratação Livre)",
                  "Estudos de viabilidade para GD (Geração Distribuída)"
            ]
      },
      "properties": {
            "dataset_info": {
                  "type": "object",
                  "description": "Informações sobre o dataset EPE",
                  "properties": {
                        "file_name": {
                              "type": "string",
                              "description": "Nome do arquivo XLSX original",
                              "example": "CONSUMO MENSAL DE ENERGIA ELÉTRICA POR CLASSE.xlsx"
                        },
                        "download_date": {
                              "type": "string",
                              "format": "date-time",
                              "description": "Data/hora do download do arquivo"
                        },
                        "file_hash": {
                              "type": "string",
                              "description": "MD5 hash do arquivo para controle de versão",
                              "pattern": "^[a-f0-9]{32}$"
                        },
                        "sheet_names": {
                              "type": "array",
                              "description": "Lista de abas/sheets presentes no XLSX",
                              "items": {
                                    "type": "string"
                              },
                              "examples": [
                                    [
                                          "Nacional",
                                          "Regiões",
                                          "Estados",
                                          "Subsistemas",
                                          "Classes",
                                          "Cativo_Livre"
                                    ]
                              ]
                        },
                        "last_data_month": {
                              "type": "string",
                              "format": "date",
                              "description": "Último mês com dados disponíveis",
                              "pattern": "^\\d{4}-\\d{2}-01$"
                        },
                        "total_records": {
                              "type": "integer",
                              "description": "Total de registros processados",
                              "minimum": 0
                        }
                  },
                  "required": [
                        "file_name",
                        "download_date",
                        "last_data_month"
                  ]
            },
            "consumo_records": {
                  "type": "array",
                  "description": "Array com os registros de consumo mensal",
                  "items": {
                        "type": "object",
                        "properties": {
                              "ano": {
                                    "type": "integer",
                                    "description": "Ano de referência",
                                    "minimum": 2004,
                                    "maximum": 2100
                              },
                              "mes": {
                                    "type": "integer",
                                    "description": "Mês de referência (1-12)",
                                    "minimum": 1,
                                    "maximum": 12
                              },
                              "data_referencia": {
                                    "type": "string",
                                    "format": "date",
                                    "description": "Data de referência no formato YYYY-MM-01",
                                    "pattern": "^\\d{4}-\\d{2}-01$"
                              },
                              "regiao": {
                                    "type": "string",
                                    "enum": [
                                          "Nacional",
                                          "Norte",
                                          "Nordeste",
                                          "Sudeste",
                                          "Sul",
                                          "Centro-Oeste"
                                    ],
                                    "description": "Região geográfica"
                              },
                              "uf": {
                                    "type": [
                                          "string",
                                          "null"
                                    ],
                                    "description": "Sigla da Unidade Federativa (AC, AL, AM, AP, BA, CE, DF, ES, GO, MA, MG, MS, MT, PA, PB, PE, PI, PR, RJ, RN, RO, RR, RS, SC, SE, SP, TO)",
                                    "pattern": "^[A-Z]{2}$"
                              },
                              "subsistema": {
                                    "type": "string",
                                    "enum": [
                                          "SIN",
                                          "Sistema Isolado",
                                          "Sudeste/Centro-Oeste",
                                          "Sul",
                                          "Nordeste",
                                          "Norte"
                                    ],
                                    "description": "Subsistema elétrico"
                              },
                              "classe_consumo": {
                                    "type": "string",
                                    "enum": [
                                          "Total",
                                          "Residencial",
                                          "Industrial",
                                          "Comercial",
                                          "Rural",
                                          "Serviço Público",
                                          "Iluminação Pública",
                                          "Outros"
                                    ],
                                    "description": "Classe de consumo"
                              },
                              "subclasse_industrial": {
                                    "type": [
                                          "string",
                                          "null"
                                    ],
                                    "enum": [
                                          null,
                                          "Metalurgia",
                                          "Química",
                                          "Alimentos e Bebidas",
                                          "Papel e Celulose",
                                          "Mineração",
                                          "Cimento",
                                          "Ferro-Ligas",
                                          "Soda-Cloro",
                                          "Outros Eletrointensivos"
                                    ],
                                    "description": "Subclasse industrial (apenas para classe Industrial)"
                              },
                              "ambiente_contratacao": {
                                    "type": "string",
                                    "enum": [
                                          "Total",
                                          "Cativo",
                                          "Livre"
                                    ],
                                    "description": "Ambiente de contratação de energia"
                              },
                              "consumo_gwh": {
                                    "type": "number",
                                    "description": "Consumo em GigaWatt-hora (GWh)",
                                    "minimum": 0
                              },
                              "consumo_mwh": {
                                    "type": "number",
                                    "description": "Consumo em MegaWatt-hora (MWh)",
                                    "minimum": 0
                              },
                              "consumo_kwh": {
                                    "type": "number",
                                    "description": "Consumo em KiloWatt-hora (kWh)",
                                    "minimum": 0
                              },
                              "numero_consumidores": {
                                    "type": [
                                          "integer",
                                          "null"
                                    ],
                                    "description": "Número de consumidores no período",
                                    "minimum": 0
                              },
                              "consumo_medio_kwh_consumidor": {
                                    "type": [
                                          "number",
                                          "null"
                                    ],
                                    "description": "Consumo médio por consumidor (kWh/consumidor)",
                                    "minimum": 0
                              },
                              "variacao_interanual_percentual": {
                                    "type": [
                                          "number",
                                          "null"
                                    ],
                                    "description": "Variação percentual em relação ao mesmo mês do ano anterior",
                                    "minimum": -100
                              },
                              "participacao_percentual_total": {
                                    "type": [
                                          "number",
                                          "null"
                                    ],
                                    "description": "Participação percentual no consumo total",
                                    "minimum": 0,
                                    "maximum": 100
                              },
                              "metadata": {
                                    "type": "object",
                                    "description": "Metadados adicionais do registro",
                                    "properties": {
                                          "fonte_dado": {
                                                "type": "string",
                                                "enum": [
                                                      "SAM",
                                                      "COPAM",
                                                      "Estimativa EPE"
                                                ],
                                                "description": "Fonte do dado"
                                          },
                                          "status_dado": {
                                                "type": "string",
                                                "enum": [
                                                      "Consolidado",
                                                      "Preliminar",
                                                      "Estimado"
                                                ],
                                                "description": "Status de consolidação do dado"
                                          },
                                          "revisao": {
                                                "type": [
                                                      "integer",
                                                      "null"
                                                ],
                                                "description": "Número da revisão (se dado foi revisado)",
                                                "minimum": 0
                                          },
                                          "observacoes": {
                                                "type": [
                                                      "string",
                                                      "null"
                                                ],
                                                "description": "Observações ou notas sobre o dado"
                                          }
                                    }
                              }
                        },
                        "required": [
                              "ano",
                              "mes",
                              "data_referencia",
                              "regiao",
                              "classe_consumo",
                              "ambiente_contratacao",
                              "consumo_gwh"
                        ]
                  }
            },
            "aggregations": {
                  "type": "object",
                  "description": "Agregações e estatísticas calculadas",
                  "properties": {
                        "consumo_total_nacional_gwh": {
                              "type": "number",
                              "description": "Consumo total nacional no período (GWh)",
                              "minimum": 0
                        },
                        "consumo_total_por_regiao": {
                              "type": "object",
                              "description": "Consumo total por região (GWh)",
                              "properties": {
                                    "Norte": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Nordeste": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Sudeste": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Sul": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Centro-Oeste": {
                                          "type": "number",
                                          "minimum": 0
                                    }
                              }
                        },
                        "consumo_total_por_classe": {
                              "type": "object",
                              "description": "Consumo total por classe (GWh)",
                              "properties": {
                                    "Residencial": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Industrial": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Comercial": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Rural": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Serviço Público": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Iluminação Pública": {
                                          "type": "number",
                                          "minimum": 0
                                    },
                                    "Outros": {
                                          "type": "number",
                                          "minimum": 0
                                    }
                              }
                        },
                        "participacao_acl_percentual": {
                              "type": "number",
                              "description": "Participação do Ambiente de Contratação Livre (%) no total",
                              "minimum": 0,
                              "maximum": 100
                        },
                        "taxa_crescimento_anual_media": {
                              "type": "number",
                              "description": "Taxa de crescimento anual média no período histórico (%)"
                        },
                        "top_estados_consumo": {
                              "type": "array",
                              "description": "Top 10 estados por consumo",
                              "items": {
                                    "type": "object",
                                    "properties": {
                                          "uf": {
                                                "type": "string",
                                                "pattern": "^[A-Z]{2}$"
                                          },
                                          "consumo_gwh": {
                                                "type": "number",
                                                "minimum": 0
                                          },
                                          "participacao_percentual": {
                                                "type": "number",
                                                "minimum": 0,
                                                "maximum": 100
                                          }
                                    }
                              },
                              "maxItems": 10
                        }
                  }
            },
            "time_series_analysis": {
                  "type": "object",
                  "description": "Análise de séries temporais",
                  "properties": {
                        "tendencia": {
                              "type": "string",
                              "enum": [
                                    "Crescimento",
                                    "Estável",
                                    "Queda"
                              ],
                              "description": "Tendência geral do consumo"
                        },
                        "sazonalidade": {
                              "type": "object",
                              "description": "Padrão de sazonalidade identificado",
                              "properties": {
                                    "presente": {
                                          "type": "boolean"
                                    },
                                    "meses_pico": {
                                          "type": "array",
                                          "items": {
                                                "type": "integer",
                                                "minimum": 1,
                                                "maximum": 12
                                          }
                                    },
                                    "meses_vale": {
                                          "type": "array",
                                          "items": {
                                                "type": "integer",
                                                "minimum": 1,
                                                "maximum": 12
                                          }
                                    }
                              }
                        },
                        "variabilidade_percentual": {
                              "type": "number",
                              "description": "Coeficiente de variação percentual da série",
                              "minimum": 0
                        }
                  }
            },
            "quality_indicators": {
                  "type": "object",
                  "description": "Indicadores de qualidade dos dados",
                  "properties": {
                        "completeness_percentual": {
                              "type": "number",
                              "description": "Percentual de completude dos dados (campos preenchidos)",
                              "minimum": 0,
                              "maximum": 100
                        },
                        "records_with_missing_data": {
                              "type": "integer",
                              "description": "Número de registros com dados faltantes",
                              "minimum": 0
                        },
                        "records_with_estimated_data": {
                              "type": "integer",
                              "description": "Número de registros com dados estimados",
                              "minimum": 0
                        },
                        "last_validation_date": {
                              "type": "string",
                              "format": "date-time",
                              "description": "Data da última validação de qualidade"
                        },
                        "validation_issues": {
                              "type": "array",
                              "description": "Lista de issues de validação encontrados",
                              "items": {
                                    "type": "object",
                                    "properties": {
                                          "severity": {
                                                "type": "string",
                                                "enum": [
                                                      "error",
                                                      "warning",
                                                      "info"
                                                ]
                                          },
                                          "message": {
                                                "type": "string"
                                          },
                                          "record_count": {
                                                "type": "integer",
                                                "minimum": 0
                                          }
                                    }
                              }
                        }
                  }
            }
      },
      "required": [
            "dataset_info",
            "consumo_records"
      ],
