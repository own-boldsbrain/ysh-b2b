# HaaS Platform - Environment Variables Example
# Copy this file to .env and adjust values for your environment

# Application Settings
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here-change-in-production-must-be-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=DEBUG

# Database Configuration
DATABASE_URL=sqlite:///./haas_platform.db
# Para PostgreSQL: postgresql://user:password@localhost/dbname
# DATABASE_URL=postgresql://haas_user:haas_password@localhost:5432/haas_db

# Redis Configuration  
REDIS_URL=redis://localhost:6379
# Com senha: redis://:password@localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Port Configuration (customizable to avoid conflicts)
HAAS_API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
HUGINN_PORT=3000

# Alternative Port Set 1 (if main ports are busy)
# HAAS_API_PORT=8100
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# ADMINER_PORT=8180
# REDIS_COMMANDER_PORT=8181
# NGINX_HTTP_PORT=8080
# NGINX_HTTPS_PORT=8443

# Alternative Port Set 2 (for multiple instances)
# HAAS_API_PORT=8200
# POSTGRES_PORT=5434
# REDIS_PORT=6381
# ADMINER_PORT=8280
# REDIS_COMMANDER_PORT=8281
# NGINX_HTTP_PORT=8082
# NGINX_HTTPS_PORT=8445

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# Webhook Settings
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3

# Logging
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=./logs/haas.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# External API Keys (if needed)
# INMETRO_API_KEY=your-inmetro-api-key
# OTHER_API_KEY=your-other-api-key

# Huginn Configuration
HUGINN_DOMAIN=localhost:3000
HUGINN_PROTOCOL=http
HUGINN_INVITATION_CODE=try-huginn
HUGINN_SEED_USERNAME=admin
HUGINN_SEED_PASSWORD=password
HUGINN_SEED_EMAIL=admin@example.com
HUGINN_TIMEZONE=America/Sao_Paulo

# Huginn SMTP (opcional - para envio de emails)
HUGINN_SMTP_DOMAIN=your-domain.com
HUGINN_SMTP_USER=
HUGINN_SMTP_PASSWORD=
HUGINN_SMTP_SERVER=smtp.gmail.com
HUGINN_SMTP_PORT=587
HUGINN_SMTP_AUTHENTICATION=plain
HUGINN_SMTP_ENABLE_STARTTLS=true
HUGINN_EMAIL_FROM=huginn@example.com

# Huginn Security
HUGINN_SECRET_KEY_BASE=generate-with-openssl-rand-hex-64

# LLM Configuration
# OpenAI Settings
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=2000
OPENAI_ENABLED=false

# Anthropic Settings
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TEMPERATURE=0.0
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_ENABLED=false

# Ollama Settings (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=smollm2:latest
OLLAMA_TIMEOUT=30
OLLAMA_TEMPERATURE=0.0
OLLAMA_ENABLED=true

# LLM Provider Priority (first available wins)
# Options: anthropic, openai, ollama, mock
LLM_PROVIDER_PRIORITY=anthropic,openai,ollama,mock