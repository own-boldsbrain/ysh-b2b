# ============================================================================
# YSH Data Pipeline - Environment Configuration
# ============================================================================
# Meta Commerce Platform Integration for Solar Equipment Catalog
# Version: 2.0.0
# Date: October 19, 2025
# ============================================================================

# ============================================================================
# META COMMERCE PLATFORM (Facebook/Instagram)
# ============================================================================

# Facebook Catalog ID (obtido no Commerce Manager)
FACEBOOK_CATALOG_ID=your_catalog_id_here

# Facebook Access Token (User ou Page Access Token com permissões de catalog)
# Scopes necessários: catalog_management, pages_manage_metadata
FACEBOOK_ACCESS_TOKEN=your_access_token_here

# Facebook Business ID (opcional, para analytics)
FACEBOOK_BUSINESS_ID=your_business_id_here

# Base URL do seu site de produtos
BASE_PRODUCT_URL=https://ysh.solar/products

# Currency code (ISO 4217)
CURRENCY=BRL

# ============================================================================
# DATABASE - PostgreSQL
# ============================================================================

DATABASE_URL=postgresql://ysh_admin:ysh_secure_2025@localhost:5432/ysh_pipeline
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ysh_pipeline
DATABASE_USER=ysh_admin
DATABASE_PASSWORD=ysh_secure_2025

# ============================================================================
# CACHE - Redis
# ============================================================================

REDIS_URL=redis://:ysh_redis_2025@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ysh_redis_2025
REDIS_DB=0

# ============================================================================
# STORAGE - MinIO (S3-compatible)
# ============================================================================

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ysh_admin
MINIO_SECRET_KEY=ysh_minio_2025
MINIO_BUCKET_DATASHEETS=ysh-datasheets
MINIO_BUCKET_IMAGES=ysh-product-images
MINIO_BUCKET_RAW_IMAGES=ysh-raw-images
MINIO_BUCKET_FEEDS=ysh-catalog-feeds
MINIO_REGION=us-east-1

# AWS S3 (production alternative to MinIO)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=sa-east-1
# AWS_S3_BUCKET=ysh-production-assets

# ============================================================================
# VECTOR DATABASE - Qdrant
# ============================================================================

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================================================
# AI/ML - Ollama (Local LLM)
# ============================================================================

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=300

# ============================================================================
# AI/ML - OpenAI (Optional, for advanced features)
# ============================================================================

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# ============================================================================
# AIRFLOW - Workflow Orchestration
# ============================================================================

AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth

# Airflow Database
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow_2025@localhost:5432/airflow

# Airflow Celery
AIRFLOW__CELERY__BROKER_URL=redis://:airflow_redis_2025@localhost:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow_2025@localhost:5432/airflow

# Airflow Web UI
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8080

# Airflow Admin User
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin_2025
AIRFLOW_WWW_USER_EMAIL=admin@ysh.solar

# ============================================================================
# MONITORING - Prometheus & Grafana
# ============================================================================

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_2025

# ============================================================================
# LOGGING - Loki & Promtail
# ============================================================================

LOKI_URL=http://localhost:3100
LOG_DIR=/var/log/ysh-pipeline
LOG_LEVEL=INFO

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment (development, staging, production)
NODE_ENV=development
PYTHON_ENV=development

# Batch sizes
SYNC_BATCH_SIZE=100
SCRAPING_BATCH_SIZE=50

# Rate limiting (requests per minute)
RATE_LIMIT_RPM=120

# Timeouts (seconds)
HTTP_TIMEOUT=30
SCRAPING_TIMEOUT=60
AI_PROCESSING_TIMEOUT=300

# ============================================================================
# MANUFACTURER WEBSITES (Scraping Targets)
# ============================================================================

# Jinko Solar
JINKO_SOLAR_URL=https://www.jinkosolar.com
JINKO_SOLAR_API_KEY=

# Growatt
GROWATT_URL=https://www.growatt.com
GROWATT_API_KEY=

# Canadian Solar
CANADIAN_SOLAR_URL=https://www.canadiansolar.com

# Solis
SOLIS_URL=https://www.solisinverters.com

# Deye
DEYE_URL=https://www.deyeinverter.com

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@ysh.solar
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=YSH Data Pipeline <alerts@ysh.solar>
SMTP_TO=data-team@ysh.solar

# Slack (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#data-pipeline-alerts

# ============================================================================
# SECURITY
# ============================================================================

# JWT Secrets (for API authentication)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Keys (for internal services)
INTERNAL_API_KEY=ysh_internal_api_key_2025

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable specific features
ENABLE_AI_CAPTIONING=true
ENABLE_BACKGROUND_REMOVAL=true
ENABLE_AUTO_RETRY=true
ENABLE_DETAILED_LOGGING=true
ENABLE_FEED_EXPORT=true

# ============================================================================
# GOOGLE PRODUCT CATEGORIES (Solar Equipment)
# ============================================================================

# Default categories for auto-classification
CATEGORY_SOLAR_PANEL="Electronics > Components > Solar Panels"
CATEGORY_INVERTER="Electronics > Components > Power Inverters"
CATEGORY_BATTERY="Electronics > Components > Batteries"
CATEGORY_STRUCTURE="Hardware > Building Materials > Solar Mounting Systems"
CATEGORY_CABLE="Electronics > Components > Cables"

# ============================================================================
# REGIONAL SETTINGS
# ============================================================================

TIMEZONE=America/Sao_Paulo
LOCALE=pt_BR
DEFAULT_LANGUAGE=pt

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Nunca commitar este arquivo com valores reais em produção
# 2. Use um secret manager (AWS Secrets Manager, Vault) em produção
# 3. Rotacione tokens e senhas regularmente
# 4. Para Meta Commerce, obtenha access token em:
#    https://developers.facebook.com/tools/explorer/
# 5. Para criar catálogo no Commerce Manager:
#    https://business.facebook.com/commerce/
#
# ============================================================================
